# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Prime Accessories Kenya"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Database — used by both docker-compose.yml and the app.
# Pick your own values (do not reuse these examples in any shared/deployed environment).
POSTGRES_USER=prime_accessories_kenya
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=prime_accessories_kenya
# In production, append &connection_limit=20&pool_timeout=30 (tune to taste) to
# the URL below. Prisma's default pool size is numCPUs*2+1 per instance, which
# is just a guess — it may not fit your Postgres server's actual max_connections,
# especially once you run multiple app instances against the same database.
# Setting these explicitly makes the pool size a deliberate choice instead of
# an accident of hardware.
DATABASE_URL=postgresql://prime_accessories_kenya:replace-with-a-strong-local-password@127.0.0.1:5432/prime_accessories_kenya?schema=public

# Payments — optional in dev (set PAYMENT_DEV_MODE=true to simulate)
PAYMENT_DEV_MODE=true

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# M-Pesa Daraja (https://developer.safaricom.co.ke)
# Sandbox: create an app on the Daraja portal to get the consumer key/secret,
# then use the "Lipa Na M-Pesa Online" test credentials for shortcode/passkey.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Random secret embedded in the Daraja callback URL path so only Safaricom's
# configured callback can reach the webhook. Generate with:
#   openssl rand -hex 32
# Safaricom cannot sign callbacks, so this path secret plus a server-side STK
# Query check is what authenticates a payment result.
MPESA_CALLBACK_SECRET=

# ─── Outbound email ─────────────────────────────────────────────────────────
# Required for password-reset emails (and any other outbound mail) to
# actually send once deployed — see apps/web/lib/mail.ts. With neither var
# set, mail is NOT sent: production fails loudly (and refuses to leak the
# reset link into logs), while development prints the message to the console
# as an explicitly-labeled dev-only fallback.
# Full SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# (or smtps://... for implicit TLS). This is the supported, fully-wired path.
SMTP_URL=
# Optional "From" header override, e.g. "Prime Accessories Kenya <no-reply@yourdomain.com>".
# Defaults to NEXT_PUBLIC_APP_NAME @ the NEXT_PUBLIC_APP_URL host.
MAIL_FROM=
# API key for an HTTP-based mail provider (Resend, SendGrid, etc.) — NOT YET
# IMPLEMENTED. Setting this alone will not send mail; see the TODO in
# apps/web/lib/mail.ts. Use SMTP_URL above instead.
MAIL_PROVIDER_API_KEY=

# ─── Networking ─────────────────────────────────────────────────────────────
# Set to "true" only when this app sits behind a reverse proxy/load balancer
# that always overwrites X-Forwarded-For / X-Real-IP on inbound requests
# (e.g. nginx, Vercel, most managed platforms). Rate limiting uses this header
# to key its buckets; trusting it with no such proxy lets a direct client
# forge a new value per request and dodge the limit entirely.
TRUST_PROXY_HEADERS=false

# ─── Error tracking ─────────────────────────────────────────────────────────
# Optional. DSN for Sentry (https://sentry.io) error tracking — get one from
# your Sentry project's Settings > Client Keys (DSN). Covers server, edge,
# and browser code (apps/web/sentry.server.config.ts, sentry.edge.config.ts,
# instrumentation-client.ts) and auto-captures existing console.error(...)
# calls app-wide via the SDK's captureConsole integration — no code changes
# needed at those call sites. Leave empty to disable error tracking entirely;
# the SDK no-ops with no DSN set, it does not throw.
SENTRY_DSN=
# Optional, and only relevant when actually uploading source maps to Sentry
# (org/project auth token from https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/).
# Without it the build's Sentry plugin just skips the upload step and warns —
# it does not fail the build. Not needed for SENTRY_DSN alone to work.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Scheduled jobs ────────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/reconcile, which re-checks payments whose
# provider callback never arrived and releases stock held by unpaid orders.
# Point a scheduler at it roughly every 15 minutes:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-host/api/cron/reconcile
# Generate with: openssl rand -hex 32
# Leave empty to disable the endpoint entirely.
CRON_SECRET=

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Prime Accessories Kenya"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Database — used by both docker-compose.yml and the app.
# Pick your own values (do not reuse these examples in any shared/deployed environment).
POSTGRES_USER=prime_accessories_kenya
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=prime_accessories_kenya
# In production, append &connection_limit=20&pool_timeout=30 (tune to taste) to
# the URL below. Prisma's default pool size is numCPUs*2+1 per instance, which
# is just a guess — it may not fit your Postgres server's actual max_connections,
# especially once you run multiple app instances against the same database.
# Setting these explicitly makes the pool size a deliberate choice instead of
# an accident of hardware.
# In production add &connection_limit=10 so the app never opens more connections than Postgres needs.
DATABASE_URL=postgresql://prime_accessories_kenya:replace-with-a-strong-local-password@127.0.0.1:5432/prime_accessories_kenya?schema=public

# Payments — optional in dev (set PAYMENT_DEV_MODE=true to simulate)
PAYMENT_DEV_MODE=true

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# M-Pesa Daraja (https://developer.safaricom.co.ke)
# Sandbox: create an app on the Daraja portal to get the consumer key/secret,
# then use the "Lipa Na M-Pesa Online" test credentials for shortcode/passkey.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
# Public HTTPS origin reachable by Safaricom (e.g. your running tunnel).
# Defaults to NEXT_PUBLIC_APP_URL. Keep this public even when browsing localhost.
MPESA_CALLBACK_BASE_URL=
# Random secret embedded in the Daraja callback URL path so only Safaricom's
# configured callback can reach the webhook. Generate with:
#   openssl rand -hex 32
# Safaricom cannot sign callbacks, so this path secret plus a server-side STK
# Query check is what authenticates a payment result.
MPESA_CALLBACK_SECRET=

# ─── Outbound email ─────────────────────────────────────────────────────────
# Required for password-reset emails (and any other outbound mail) to
# actually send once deployed — see apps/web/lib/mail.ts. With neither var
# set, mail is NOT sent: production fails loudly (and refuses to leak the
# reset link into logs), while development prints the message to the console
# as an explicitly-labeled dev-only fallback.
# SMTP server. Brevo example (see docs/email-brevo.md):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587      (587 or 2525 upgrade with STARTTLS; 465 is TLS from the start)
#   SMTP_USER=         your Brevo SMTP login, e.g. 1234abc@smtp-brevo.com
#   SMTP_PASS=         a Brevo SMTP key (not your account password, not an API key)
# The connection is always encrypted; a server that will not upgrade is refused.
SMTP_HOST=
SMTP_PORT=587
# Optional. Leave empty: port 465 uses TLS from the start, other ports STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Older single-string form, still supported and used instead of the four above
# when set. Any "@" in the login must be written as %40, e.g.
# smtp://1234abc%40smtp-brevo.com:KEY@smtp-relay.brevo.com:587
SMTP_URL=
# Sender. Must be an address on a domain you have verified with your mail
# provider, e.g. "Prime Accessories Kenya <orders@yourdomain.co.ke>".
# Without it the app uses no-reply@<site host>, which providers usually refuse.
MAIL_FROM=
# Optional: where customer replies go, e.g. support@yourdomain.co.ke.
MAIL_REPLY_TO=
# API key for an HTTP-based mail provider (Resend, SendGrid, etc.) — NOT YET
# IMPLEMENTED. Setting this alone will not send mail; see the TODO in
# apps/web/lib/mail.ts. Use the SMTP settings above instead.
MAIL_PROVIDER_API_KEY=

# ─── Networking ─────────────────────────────────────────────────────────────
# Set to "true" only when this app sits behind a reverse proxy/load balancer
# that always overwrites X-Forwarded-For / X-Real-IP on inbound requests
# (e.g. nginx, Vercel, most managed platforms). Rate limiting uses this header
# to key its buckets; trusting it with no such proxy lets a direct client
# forge a new value per request and dodge the limit entirely.
TRUST_PROXY_HEADERS=false

# ─── Error tracking ─────────────────────────────────────────────────────────
# Optional. DSN for Sentry (https://sentry.io) error tracking — get one from
# your Sentry project's Settings > Client Keys (DSN). Covers server, edge,
# and browser code (apps/web/sentry.server.config.ts, sentry.edge.config.ts,
# instrumentation-client.ts) and auto-captures existing console.error(...)
# calls app-wide via the SDK's captureConsole integration — no code changes
# needed at those call sites. Leave empty to disable error tracking entirely;
# the SDK no-ops with no DSN set, it does not throw.
SENTRY_DSN=
# Optional, and only relevant when actually uploading source maps to Sentry
# (org/project auth token from https://sentry.io/orgredirect/organizations/:org/settings/auth-tokens/).
# Without it the build's Sentry plugin just skips the upload step and warns —
# it does not fail the build. Not needed for SENTRY_DSN alone to work.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Scheduled jobs ────────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/reconcile, which re-checks payments whose
# provider callback never arrived and releases stock held by unpaid orders.
# Point a scheduler at it roughly every 15 minutes:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-host/api/cron/reconcile
# Generate with: openssl rand -hex 32
# Leave empty to disable the endpoint entirely.
CRON_SECRET=

# ─── Seeding ───────────────────────────────────────────────────────────────
# Password for the admin account `pnpm db:seed` creates (12+ characters).
# Required when NODE_ENV=production. Re-running the seed only changes an
# existing admin's password when this is set.
SEED_ADMIN_EMAIL=admin@primeaccessorieskenya.co.ke
SEED_ADMIN_PASSWORD=

# Where admin image uploads are stored. Leave unset to use apps/web/public/uploads.
# In production use a persistent folder outside the app (the Docker image uses /data/uploads) and back it up.
# UPLOAD_DIR=/var/lib/prime/uploads

# ─── Scaling ───────────────────────────────────────────────────────────────
# How many copies of the app run behind the load balancer. Default 1.
# APP_INSTANCES=1
# Server Actions are encrypted with a key that `next build` creates. Copies
# started from the same build (same Docker image) already share it. If you
# build more than once (for example on each server), set this to the SAME value
# for every build and every instance. Required when APP_INSTANCES is above 1.
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Database pool. Prisma reads these from the DATABASE_URL query string, so no
# code change is needed. Example:
#   DATABASE_URL=postgresql://user:pass@host:5432/db?connection_limit=10&pool_timeout=10
# connection_limit is the pool size for ONE process. See docs/connection-budget.md.

# Process and database metrics, one JSON log line each interval. On by default.
# METRICS_LOG=false
# METRICS_INTERVAL_SECONDS=30

# File storage: "local" (default) or "s3" (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# For s3 also run: pnpm add @aws-sdk/client-s3 --filter web
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_PREFIX=uploads/
# S3_FORCE_PATH_STYLE=false

# ─── Background jobs ───────────────────────────────────────────────────────
# Emails (password reset, order confirmation, back in stock) are queued in the
# database and sent by a worker inside the app. See docs/background-jobs.md.
# JOBS_WORKER=false                 # do not run the worker on this server
# JOBS_POLL_SECONDS=3
# JOBS_BATCH=5
# Queue the payment check every N minutes from the app itself (0 or unset = off).
# Safe alongside the external cron: both share one lease.
# JOBS_RECONCILE_EVERY_MINUTES=15

# ─── Rate limits ───────────────────────────────────────────────────────────
# "postgres" (default): counts are shared by every app instance.
# "memory": counts stay in this process only (fine for one server).
# RATE_LIMIT_STORE=postgres
